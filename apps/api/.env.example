PORT=3001
APP_NAME="Enterprise Agentic SaaS"
APP_BASE_URL=https://enterprise-agentic-saas.localhost
API_PUBLIC_URL=https://api.enterprise-agentic-saas.localhost
BETTER_AUTH_URL=https://api.enterprise-agentic-saas.localhost
NEXT_PUBLIC_API_BASE_URL=https://api.enterprise-agentic-saas.localhost
BETTER_AUTH_SECRET="replace-me"
AUTH_COOKIE_DOMAIN=enterprise-agentic-saas.localhost
TRUSTED_ORIGINS=https://enterprise-agentic-saas.localhost
CORS_ORIGIN=https://enterprise-agentic-saas.localhost
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"
TURSO_DATABASE_URL=https://db.enterprise-agentic-saas.localhost
# TURSO_AUTH_TOKEN=
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@example.test
# `bun run dev` resolves the worktree-aware Mailpit URL with portless.
# MAILPIT_URL=http://localhost:8025

# Sentry SaaS。localでSpotlightを使う場合、DSNは不要。
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=git-sha-or-release-name
SENTRY_SPOTLIGHT=false
SENTRY_TRACES_SAMPLE_RATE=0.1
