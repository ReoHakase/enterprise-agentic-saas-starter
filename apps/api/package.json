{
  "name": "@enterprise-agentic-saas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./agent-client": {
      "types": "./src/agent-client.ts",
      "default": "./src/agent-client.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target bun --outdir ./dist --production",
    "build:cloudflare": "wrangler deploy --dry-run --outdir ./dist/worker",
    "cf:typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false --include-runtime=false --env-interface CloudflareEnv src/cloudflare-env.d.ts && oxfmt src/cloudflare-env.d.ts",
    "deploy": "bun run build:cloudflare && bun run sentry:sourcemaps && wrangler deploy ./dist/worker/worker.js --no-bundle",
    "dev": "portless-topology run api.enterprise-agentic-saas -- bun run src/dev.ts",
    "dev:portless": "bun run dev",
    "dev:spotlight": "portless-topology run api.enterprise-agentic-saas -- spotlight run -p 8969 bun run src/dev.ts",
    "dev:worker": "wrangler dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "start": "NODE_ENV=production bun ./dist/index.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject ./dist/worker && sentry-cli sourcemaps upload --release \"$SENTRY_RELEASE\" --validate --strict --wait ./dist/worker",
    "smoke:upload-memory": "bun run src/smoke/upload-memory/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysia/cors": "catalog:",
    "@elysia/eden": "catalog:",
    "@elysia/openapi": "catalog:",
    "@elysiajs/server-timing": "catalog:",
    "@enterprise-agentic-saas/agent-contracts": "workspace:*",
    "@enterprise-agentic-saas/auth": "workspace:*",
    "@enterprise-agentic-saas/db": "workspace:*",
    "@enterprise-agentic-saas/email": "workspace:*",
    "@sentry/bun": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "envin": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/portless-topology": "workspace:*",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@libsql/client": "catalog:",
    "@sentry/cli": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "api.enterprise-agentic-saas"
  }
}
