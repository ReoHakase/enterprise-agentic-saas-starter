{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "enterprise-agentic-saas-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "upload_source_maps": true,
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "enterprise-agentic-saas-attachments",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "cache": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
