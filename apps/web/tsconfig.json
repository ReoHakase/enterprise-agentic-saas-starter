{
  "extends": "@enterprise-agentic-saas/typescript-config/react-library.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"],
      "@enterprise-agentic-saas/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "oxlint.config.ts", "dist", "storybook-static"]
}
