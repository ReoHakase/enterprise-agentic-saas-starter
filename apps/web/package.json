{
  "name": "@enterprise-agentic-saas/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:storybook": "node node_modules/storybook/dist/bin/dispatcher.js build --config-dir .storybook --output-dir storybook-static",
    "cf:typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts && oxfmt cloudflare-env.d.ts",
    "deploy": "opennextjs-cloudflare deploy",
    "dev": "portless run next dev --turbopack",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:portless": "bun run dev",
    "dev:spotlight": "spotlight run -p 8969 bun run dev",
    "e2e:github-emulator": "bun run --cwd ../github-emulator dev:http",
    "e2e:mock-api": "bun run e2e/fixtures/mock-api.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "storybook": "node node_modules/storybook/dist/bin/dispatcher.js dev --config-dir .storybook --port 6007 --no-open",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=storybook-light --project=storybook-dark --project=browser",
    "test:e2e": "bun run test:e2e:app && bun run test:e2e:scripted-agent && bun run test:e2e:oauth",
    "test:e2e:agent": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.agent.config.ts",
    "test:e2e:app": "bun run test:e2e:app:core && bun run test:e2e:route-contracts",
    "test:e2e:app:core": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test",
    "test:e2e:oauth": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.oauth.config.ts",
    "test:e2e:route-contracts": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.route-contracts.config.ts --workers=1",
    "test:e2e:scripted-agent": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.e2.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@better-auth-ui/core": "catalog:",
    "@better-auth-ui/react": "catalog:",
    "@enterprise-agentic-saas/api": "workspace:*",
    "@enterprise-agentic-saas/auth": "workspace:*",
    "@enterprise-agentic-saas/ui": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "bowser": "catalog:",
    "date-fns": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@spotlightjs/spotlight": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "happy-dom": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "enterprise-agentic-saas"
  }
}
