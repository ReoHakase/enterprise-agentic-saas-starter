{
  "name": "@enterprise-agentic-saas/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#storybook/*": "./.storybook/*.tsx"
  },
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3001 NEXT_DIST_DIR=.next-browser NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001 next build",
    "build:storybook": "node node_modules/storybook/dist/bin/dispatcher.js build --config-dir .storybook --output-dir storybook-static",
    "cf:typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts && oxfmt cloudflare-env.d.ts",
    "deploy": "opennextjs-cloudflare deploy",
    "dev": "portless run next dev --turbopack",
    "dev:portless": "bun run dev",
    "dev:spotlight": "spotlight run -p 8969 bun run dev",
    "e2e:github-emulator": "bun run --cwd ../github-emulator dev:http",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "start:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3001 NEXT_DIST_DIR=.next-browser NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001 next start --hostname 127.0.0.1 --port 3000",
    "storybook": "node node_modules/storybook/dist/bin/dispatcher.js dev --config-dir .storybook --port 6007 --no-open",
    "test": "vitest run --project=unit",
    "test:browser": "bun run test:browser:components && bun run test:browser:app",
    "test:browser:app": "bun run build:test:browser:app && bun run test:browser:app:chromium && bun run test:browser:app:webkit",
    "test:browser:app:chromium": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.app.config.ts --project=w6-chromium",
    "test:browser:app:webkit": "bun run scripts/run-w6-webkit.ts",
    "test:browser:components": "vitest run --project=storybook-light --project=storybook-dark && vitest run --project=browser",
    "test:browser:coverage": "env BROWSER_COVERAGE=1 vitest run --project=storybook-light --project=storybook-dark && env BROWSER_COVERAGE=1 vitest run --project=browser",
    "test:browser:mock-api": "bun run test/app/fixtures/mock-api.ts",
    "test:e2e": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.deterministic.config.ts",
    "test:e2e:full": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.full.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@better-auth-ui/core": "catalog:",
    "@better-auth-ui/react": "catalog:",
    "@enterprise-agentic-saas/api": "workspace:*",
    "@enterprise-agentic-saas/auth": "workspace:*",
    "@enterprise-agentic-saas/ui": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "bowser": "catalog:",
    "date-fns": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@spotlightjs/spotlight": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "happy-dom": "catalog:",
    "msw": "catalog:",
    "msw-storybook-addon": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "enterprise-agentic-saas"
  }
}
