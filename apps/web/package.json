{
  "name": "@enterprise-agentic-saas/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "opennextjs-cloudflare deploy",
    "dev": "portless run next dev --turbopack",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:portless": "bun run dev",
    "dev:spotlight": "spotlight run -p 8969 bun run dev",
    "e2e:mock-api": "bun run e2e/fixtures/mock-api.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@better-auth-ui/core": "catalog:",
    "@better-auth-ui/react": "catalog:",
    "@enterprise-agentic-saas/api": "workspace:*",
    "@enterprise-agentic-saas/auth": "workspace:*",
    "@enterprise-agentic-saas/ui": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@spotlightjs/spotlight": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "enterprise-agentic-saas"
  }
}
