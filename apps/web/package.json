{
  "name": "@enterprise-agentic-saas/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#storybook/*": "./.storybook/*.tsx"
  },
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3201 NEXT_DIST_DIR=.next-browser NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3201 NEXT_PUBLIC_BROWSER_TEST=true next build",
    "build:storybook": "storybook build",
    "cf:typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts && oxfmt cloudflare-env.d.ts",
    "deploy": "opennextjs-cloudflare deploy",
    "dev": "portless-topology run enterprise-agentic-saas -- next dev --turbopack",
    "dev:portless": "bun run dev",
    "e2e:emulate:github": "bun run --cwd ../emulate dev:http",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "start:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3201 NEXT_DIST_DIR=.next-browser NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3201 next start --hostname 127.0.0.1 --port 3200",
    "storybook": "portless-topology run storybook.enterprise-agentic-saas -- storybook dev --no-open --exact-port",
    "test": "vitest run --project=unit",
    "test:browser": "bun run test:browser:components && bun run test:browser:app",
    "test:browser:app": "bun run build:test:browser:app && bun run test:browser:app:chromium && bun run test:browser:app:webkit",
    "test:browser:app:chromium": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.app.config.ts --project=nextjs-integration-chromium",
    "test:browser:app:webkit": "bun run scripts/run-nextjs-integration-webkit.ts",
    "test:browser:components": "bun run test:browser:storybook:light && bun run test:browser:storybook:dark && bun run test:browser:mode",
    "test:browser:coverage": "env BROWSER_COVERAGE=1 vitest run --project=storybook-light && env BROWSER_COVERAGE=1 vitest run --project=storybook-dark && env BROWSER_COVERAGE=1 vitest run --project=browser",
    "test:browser:mode": "vitest run --project=browser",
    "test:browser:mock-api": "bun run test/app/fixtures/mock-api.ts",
    "test:browser:storybook:dark": "vitest run --project=storybook-dark",
    "test:browser:storybook:light": "vitest run --project=storybook-light",
    "test:e2e": "env -u NO_COLOR node node_modules/@playwright/test/cli.js test --config playwright.deterministic.config.ts",
    "test:e2e:full": "bun --no-env-file e2e/fixtures/run-full-e2e.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@better-auth-ui/core": "catalog:",
    "@better-auth-ui/react": "catalog:",
    "@enterprise-agentic-saas/api": "workspace:*",
    "@enterprise-agentic-saas/auth": "workspace:*",
    "@enterprise-agentic-saas/ui": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-document-load": "0.66.0",
    "@opentelemetry/instrumentation-fetch": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "bowser": "catalog:",
    "date-fns": "catalog:",
    "jotai": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/portless-topology": "workspace:*",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "happy-dom": "catalog:",
    "msw": "catalog:",
    "msw-storybook-addon": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "portless": {
    "name": "enterprise-agentic-saas"
  }
}
