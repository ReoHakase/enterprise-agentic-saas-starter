{
  "name": "@enterprise-agentic-saas/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#storybook/*": "./.storybook/*.tsx"
  },
  "scripts": {
    "build": "vite build",
    "build:cloudflare": "bun run build && wrangler deploy --dry-run",
    "build:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3201 VITE_API_BASE_URL=http://127.0.0.1:3201 VITE_BROWSER_TEST=true PLAYWRIGHT_TEST=true vite build",
    "build:storybook": "storybook build",
    "cf:typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts && oxfmt cloudflare-env.d.ts",
    "deploy": "bun run build && wrangler deploy",
    "dev": "portless-topology run enterprise-agentic-saas -- vite dev",
    "e2e:emulate:github": "bun run --cwd ../emulate dev:http",
    "lint": "oxlint --deny-warnings",
    "postinstall": "fumadocs-mdx",
    "preview": "vite preview",
    "start:test:browser:app": "env API_PUBLIC_URL=http://127.0.0.1:3201 VITE_API_BASE_URL=http://127.0.0.1:3201 PLAYWRIGHT_TEST=true vite preview --host 127.0.0.1 --port 3200",
    "storybook": "portless-topology run storybook.enterprise-agentic-saas -- storybook dev --no-open --exact-port",
    "test": "vitest run --config ../../vitest.config.ts --project=web-unit",
    "test:browser": "bun run test:browser:components && bun run test:browser:app",
    "test:browser:app": "bun run build:test:browser:app && bun run test:browser:app:chromium && bun run test:browser:app:webkit",
    "test:browser:app:chromium": "env -u NO_COLOR WEB_PLAYWRIGHT_PROFILE=app node node_modules/@playwright/test/cli.js test --config playwright.config.ts --project=tanstack-start-integration-chromium",
    "test:browser:app:webkit": "bun run e2e/fixtures/run-tanstack-start-integration-webkit.ts",
    "test:browser:components": "bun run test:browser:storybook:light && bun run test:browser:storybook:dark && bun run test:browser:mode",
    "test:browser:coverage": "env BROWSER_COVERAGE=1 vitest run --config ../../vitest.config.ts --project=web-storybook-light && env BROWSER_COVERAGE=1 vitest run --config ../../vitest.config.ts --project=web-storybook-dark && env BROWSER_COVERAGE=1 vitest run --config ../../vitest.config.ts --project=web-browser",
    "test:browser:mode": "vitest run --config ../../vitest.config.ts --project=web-browser",
    "test:browser:mock-api": "bun run e2e/app/fixtures/mock-api.ts",
    "test:browser:storybook:dark": "vitest run --config ../../vitest.config.ts --project=web-storybook-dark",
    "test:browser:storybook:light": "vitest run --config ../../vitest.config.ts --project=web-storybook-light",
    "test:e2e": "env -u NO_COLOR WEB_PLAYWRIGHT_PROFILE=deterministic node node_modules/@playwright/test/cli.js test --config playwright.config.ts",
    "test:e2e:full": "bun --no-env-file e2e/fixtures/run-full-e2e.ts",
    "typecheck": "tsc --noEmit"
  },
