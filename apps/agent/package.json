{
  "name": "@enterprise-agentic-saas/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloudflare": "wrangler deploy --dry-run --outdir ./dist/worker && bun run scripts/assert-production-bundle.ts && bun run build:cloudflare:e2e",
    "build:cloudflare:e2e": "wrangler deploy --dry-run --config wrangler.e2e.jsonc --outdir ./dist/e2e-worker",
    "cf:typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false --include-runtime=false --env-interface CloudflareEnv src/cloudflare-env.d.ts && oxfmt src/cloudflare-env.d.ts",
    "deploy": "wrangler deploy",
    "dev": "portless-topology run agent.enterprise-agentic-saas -- sh ../../scripts/wrangler-dev-portless.sh",
    "dev:portless": "bun run dev",
    "dev:studio": "MASTRA_AUTO_DETECT_URL=true portless-topology run mastra-studio.enterprise-agentic-saas -- mastra dev --env .env.local",
    "dev:worker": "wrangler dev --env-file .dev.vars.example --env-file .env.local",
    "format": "oxfmt --ignore-path ../../.gitignore",
    "format:check": "oxfmt --check --ignore-path ../../.gitignore",
    "lint": "oxlint --deny-warnings",
    "smoke:mastra": "bun run scripts/mastra-openrouter-smoke.ts",
    "test": "vitest run",
    "test:eval:agent": "bun run src/mastra/evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enterprise-agentic-saas/api": "workspace:*",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/core": "catalog:",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@enterprise-agentic-saas/portless-topology": "workspace:*",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "mastra": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "agent.enterprise-agentic-saas"
  }
}
