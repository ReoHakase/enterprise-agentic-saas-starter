{
  "name": "@enterprise-agentic-saas/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloudflare": "wrangler deploy --dry-run --outdir ./dist/worker && bun run scripts/assert-production-bundle.ts && bun run build:cloudflare:e2e",
    "build:cloudflare:e2e": "wrangler deploy --dry-run --config wrangler.e2e.jsonc --outdir ./dist/e2e-worker",
    "cf:typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false --include-runtime=false --env-interface CloudflareEnv src/cloudflare-env.d.ts && oxfmt src/cloudflare-env.d.ts",
    "deploy": "wrangler deploy",
    "dev": "portless-topology run agent.enterprise-agentic-saas -- bun run scripts/wrangler-portless.ts",
    "dev:portless": "bun run dev",
    "dev:studio": "NODE_ENV=development MASTRA_AUTO_DETECT_URL=true portless-topology run mastra-studio.enterprise-agentic-saas -- mastra dev --env .env.local",
    "dev:worker": "wrangler dev --env-file .dev.vars.example --env-file .env.local",
    "format": "oxfmt --ignore-path ../../.gitignore",
    "format:check": "oxfmt --check --ignore-path ../../.gitignore",
    "lint": "oxlint --deny-warnings",
    "smoke:mastra": "bun run scripts/mastra-openrouter-smoke.ts",
    "storage:dev": "portless-topology run agent-storage.enterprise-agentic-saas -- bun run storage:dev:serve",
    "storage:dev:serve": "mkdir -p .local/mastra && turso dev --db-file .local/mastra/dev.db --port ${PORT:-8080}",
    "storage:reset": "bun run scripts/reset-storage.ts",
    "storage:smoke": "portless-topology exec -- bun run scripts/storage-smoke.ts",
    "test": "vitest run",
    "test:g4-memory-host": "bun --no-env-file run scripts/g4-memory-host.ts",
    "test:eval:agent": "bun run src/mastra/evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enterprise-agentic-saas/agent-contracts": "workspace:*",
    "@enterprise-agentic-saas/agent-tools": "workspace:*",
    "@inference-net/otel-cf-workers": "2.5.0",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/core": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/memory": "catalog:",
    "@mastra/observability": "1.16.3",
    "@mastra/otel-bridge": "1.4.4",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.218.0",
    "@valibot/to-json-schema": "catalog:",
    "ai": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@enterprise-agentic-saas/portless-topology": "workspace:*",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "mastra": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "portless": {
    "name": "agent.enterprise-agentic-saas"
  }
}
