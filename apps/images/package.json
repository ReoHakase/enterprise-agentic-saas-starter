{
  "name": "@enterprise-agentic-saas/images",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloudflare": "wrangler deploy --dry-run --outdir ./dist/worker",
    "cf:typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv src/cloudflare-env.d.ts && oxfmt src/cloudflare-env.d.ts",
    "deploy": "wrangler deploy",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --config ../../vitest.config.ts --project=images-unit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
