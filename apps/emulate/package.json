{
  "name": "@enterprise-agentic-saas/emulate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "portless-topology run github.emulate.enterprise-agentic-saas -- next dev --turbopack",
    "dev:http": "next dev --hostname 127.0.0.1",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --config ../../vitest.config.ts --project=emulate-unit",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@emulators/adapter-next": "catalog:",
    "@emulators/github": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/portless-topology": "workspace:*",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
