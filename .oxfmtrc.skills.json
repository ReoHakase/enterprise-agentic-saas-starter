{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "printWidth": 80,
  "semi": false,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "ignorePatterns": [
    ".next/**",
    "**/.next/**",
    ".turbo/**",
    "**/.turbo/**",
    "coverage/**",
    "**/coverage/**",
    "dist/**",
    "**/dist/**",
    "node_modules/**",
    "**/node_modules/**",
    "storybook-static/**",
    "**/storybook-static/**",
    "test-results/**",
    "**/test-results/**",
    "playwright-report/**"
  ]
}
