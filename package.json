  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "turbo run build:cloudflare",
    "build:storybook": "turbo run build:storybook",
    "check": "bun run check:static && bun run format:check && bun run typecheck && bun run test",
    "check:static": "bun run lint && knip && knip --strict && jscpd --config .jscpd.json",
    "dev": "turbo run dev",
    "dev:db": "turbo run dev --filter=@enterprise-agentic-saas/db",
    "dev:db:reset": "bun run --cwd packages/db ../../scripts/reset-local-data.ts",
    "dev:db:seed": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} bun run --cwd apps/api src/development/seed-command.ts",
    "dev:agent:studio": "turbo run dev:studio --filter=@enterprise-agentic-saas/agent",
    "dev:spotlight": "spotlight run -p 8969 bun run dev",
    "dev:storybook": "turbo run storybook",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run lint:root && turbo run lint",
    "lint:root": "oxlint --deny-warnings .codex .github scripts commitlint.config.ts knip.config.ts oxfmt.config.ts oxlint.config.ts vitest.config.ts",
    "prepare": "lefthook install",
    "test": "vitest run --config vitest.config.ts && turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e --filter=@enterprise-agentic-saas/web",
    "test:e2e:agent": "turbo run test:e2e:agent --filter=@enterprise-agentic-saas/web",
    "test:eval:agent": "turbo run test:eval:agent --filter=@enterprise-agentic-saas/agent",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@socketsecurity/bun-security-scanner": "catalog:",
    "@spotlightjs/spotlight": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@opennextjs/cloudflare@1.20.2": "patches/@opennextjs%2Fcloudflare@1.20.2.patch",
    "@base-ui/react@1.6.0": "patches/@base-ui%2Freact@1.6.0.patch",
    "next@16.2.11": "patches/next@16.2.11.patch"
  }
