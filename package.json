  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "turbo run build:cloudflare",
    "build:storybook": "turbo run build:storybook",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "dev": "turbo run dev",
    "dev:db": "turbo run dev --filter=@enterprise-agentic-saas/db",
    "dev:db:reset": "bun run --cwd packages/db ../../scripts/reset-local-data.ts",
    "dev:db:seed": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} bun run --cwd apps/api src/development/seed-command.ts",
    "dev:spotlight": "spotlight run -p 8969 bun run dev",
    "dev:storybook": "turbo run storybook --filter=@enterprise-agentic-saas/ui",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@enterprise-agentic-saas/web",
    "test:e2e:oauth": "turbo run test:e2e:oauth --filter=@enterprise-agentic-saas/web",
    "test:storybook": "turbo run test:storybook --filter=@enterprise-agentic-saas/ui",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@commitlint/types": "20.5.0",
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@spotlightjs/spotlight": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
