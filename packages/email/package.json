{
  "name": "@enterprise-agentic-saas/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./runtime": {
      "types": "./src/runtime/types.ts",
      "workerd": "./src/runtime/workerd.ts",
      "default": "./src/runtime/default.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "portless run sh -c 'exec bun email dev --dir src/templates --port \"$PORT\"'",
    "dev:mailpit": "portless run --name mailpit.enterprise-agentic-saas sh -c 'mkdir -p .local && exec mailpit --listen \"${HOST:-127.0.0.1}:$PORT\" --smtp 127.0.0.1:0 --database .local/mailpit.db --disable-version-check'",
    "mailpit:reset": "rm -f .local/mailpit.db .local/mailpit.db-shm .local/mailpit.db-wal .local/mailpit.db-journal",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "react": "catalog:",
    "react-email": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@react-email/ui": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "portless": {
    "name": "email.enterprise-agentic-saas"
  }
}
