{
  "name": "@enterprise-agentic-saas/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./development-seed": "./src/development-seed.ts",
    "./local-development": "./src/local-database.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:check": "drizzle-kit check",
    "db:assert-local": "bun run src/assert-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} drizzle-kit migrate",
    "db:prepare": "bun run db:generate && bun run db:migrate",
    "db:reset": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} bun run src/reset.ts",
    "db:seed": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} bun run src/seed.ts",
    "db:wait": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} bun run src/wait.ts",
    "db:bootstrap": "bun run db:assert-local && bun run db:wait && bun run db:prepare",
    "db:studio": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/.portless/ca.pem} drizzle-kit studio",
    "db:turso": "portless run bun run db:turso:serve",
    "db:turso:serve": "mkdir -p .local/turso && turso dev --db-file .local/turso/dev.db --port ${PORT:-8080}",
    "dev": "bun run db:bootstrap && bun run db:studio",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "drizzle-orm": "catalog:",
    "envin": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@enterprise-agentic-saas/typescript-config": "workspace:*",
    "@faker-js/faker": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-seed": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "portless": {
    "name": "db.enterprise-agentic-saas"
  }
}
