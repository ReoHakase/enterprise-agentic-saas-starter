{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ERROR_SAMPLE_RATE",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "build:cloudflare": {
      "cache": false,
      "outputs": [".open-next/**", "dist/worker/**"],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ERROR_SAMPLE_RATE",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM"
      ],
      "outputs": ["coverage/**"]
    },
    "test:storybook": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BASE_URL"]
    },
    "test:e2e:oauth": {
      "cache": false,
      "outputs": ["test-results/oauth/**", "playwright-report/oauth/**"],
      "passThroughEnv": ["CI"]
    },
    "test:e2e:agent": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "OPENROUTER_API_KEY"]
    },
    "test:eval:agent": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "OPENROUTER_API_KEY"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build:cloudflare"],
      "cache": false,
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE"
      ]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "MAILPIT_URL",
        "GITHUB_OAUTH_EMULATOR_URL",
        "GITHUB_OAUTH_EMULATOR_CLIENT_ID",
        "GITHUB_OAUTH_EMULATOR_CLIENT_SECRET",
        "GITHUB_OAUTH_CALLBACK_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ERROR_SAMPLE_RATE",
        "SENTRY_RELEASE",
        "SENTRY_SPOTLIGHT",
        "SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "NEXT_PUBLIC_SENTRY_SPOTLIGHT"
      ]
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "dev:studio": {
      "cache": false,
      "persistent": true
    },
    "@enterprise-agentic-saas/db#dev": {
      "cache": false,
      "persistent": true,
      "with": ["@enterprise-agentic-saas/db#db:turso"]
    },
    "@enterprise-agentic-saas/db#db:turso": {
      "cache": false,
      "persistent": true
    },
    "@enterprise-agentic-saas/db#db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
