{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "DEV_SESSION_ID",
        "DEV_WORKTREE_ID",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": ["MASTRA_STORAGE_AUTH_TOKEN", "MASTRA_STORAGE_URL"]
    },
    "build:cloudflare": {
      "cache": false,
      "outputs": [".open-next/**", "dist/worker/**", "dist/e2e-worker/**"],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "DEV_SESSION_ID",
        "DEV_WORKTREE_ID",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_API_TOKEN",
        "MASTRA_STORAGE_AUTH_TOKEN",
        "MASTRA_STORAGE_URL"
      ]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "env": [
        "NODE_ENV",
        "APP_NAME",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM"
      ],
      "outputs": ["coverage/**"]
    },
    "test:browser": {
      "dependsOn": ["transit"],
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"],
      "passThroughEnv": [
        "AGENT_E2E_OBSERVABILITY",
        "AGENT_E2E_RUN_ID",
        "CI",
        "DETERMINISTIC_E2E_PROFILE",
        "PLAYWRIGHT_BASE_URL"
      ]
    },
    "test:e2e:full": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "AGENT_E2E_OBSERVABILITY",
        "AGENT_E2E_RUN_ID",
        "CI",
        "OPENROUTER_API_KEY",
        "PAID_E2E_APPROVED"
      ]
    },
    "test:eval:agent": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["AGENT_EVAL_CASES", "CI", "OPENROUTER_API_KEY"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build:cloudflare"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "APP_BASE_URL",
        "API_PUBLIC_URL",
        "NEXT_PUBLIC_API_BASE_URL",
        "BETTER_AUTH_URL",
        "AUTH_COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "CORS_ORIGIN",
        "TURSO_DATABASE_URL",
        "MAILPIT_URL",
        "GITHUB_OAUTH_EMULATOR_URL",
        "GITHUB_OAUTH_EMULATOR_CLIENT_ID",
        "GITHUB_OAUTH_EMULATOR_CLIENT_SECRET",
        "GITHUB_OAUTH_CALLBACK_URL",
        "DEV_SESSION_ID",
        "DEV_WORKTREE_ID",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "NEXT_PUBLIC_DEV_SESSION_ID",
        "NEXT_PUBLIC_DEV_WORKTREE_ID",
        "NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT"
      ],
      "passThroughEnv": ["MASTRA_STORAGE_AUTH_TOKEN", "MASTRA_STORAGE_URL"]
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "dev:studio": {
      "cache": false,
      "persistent": true
    },
    "storage:dev": {
      "cache": false,
      "persistent": true
    },
    "@enterprise-agentic-saas/agent#dev": {
      "with": ["@enterprise-agentic-saas/agent#storage:dev"]
    },
    "@enterprise-agentic-saas/agent#dev:studio": {
      "with": ["@enterprise-agentic-saas/agent#storage:dev"]
    },
    "@enterprise-agentic-saas/db#dev": {
      "cache": false,
      "persistent": true,
      "with": ["@enterprise-agentic-saas/db#db:turso"]
    },
    "@enterprise-agentic-saas/db#db:turso": {
      "cache": false,
      "persistent": true
    },
    "@enterprise-agentic-saas/db#db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
