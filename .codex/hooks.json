{
  "description": "Repository policy and workflow context for the coding harness.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bun \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.ts\"",
            "timeout": 10,
            "statusMessage": "Repository contextを読み込み中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|shell|write_stdin|apply_patch|Edit|Write|.*write.*|.*edit.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bun \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-use-policy.ts\"",
            "timeout": 10,
            "statusMessage": "Repository policyを確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|bash|exec|exec_command|shell|write_stdin|apply_patch|Edit|Write|.*write.*|.*edit.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bun \"$(git rev-parse --show-toplevel)/.codex/hooks/post-tool-use-review.ts\"",
            "timeout": 10,
            "statusMessage": "Harness review要否を確認中"
          }
        ]
      }
    ]
  }
}
